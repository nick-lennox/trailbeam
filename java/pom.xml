<?xml version="1.0" encoding="UTF-8"?>
<!--
  Trailbeam for the AWS SDK for Java v2: a global ExecutionInterceptor that emits the spans of
  contract/span-contract.md. Users add this one dependency and change no code.

  The group ID app.trailbeam is the board's choice (QV-312 card, 2026-11-23): the product domain, trailbeam.app.
  The OpenTelemetry SDK is relocated into the jar (QV-312 report, section 3, point 4), so it never conflicts
  with the application's own OpenTelemetry and the OpenTelemetry Java agent's API bridge never sees it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>app.trailbeam</groupId>
  <artifactId>trailbeam-aws-sdk-v2</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Trailbeam for the AWS SDK for Java v2</name>
  <description>Per-message SQS timeline spans (Trailbeam span contract 3.x) from a global AWS SDK v2 ExecutionInterceptor.</description>
  <url>https://github.com/nick-lennox/trailbeam</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
  <!-- Maven Central requires developers and scm. -->
  <developers>
    <developer>
      <name>Trailbeam maintainers</name>
      <organization>Trailbeam</organization>
      <organizationUrl>https://github.com/nick-lennox/trailbeam</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/nick-lennox/trailbeam.git</connection>
    <developerConnection>scm:git:https://github.com/nick-lennox/trailbeam.git</developerConnection>
    <url>https://github.com/nick-lennox/trailbeam</url>
  </scm>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The SDK the jar is compiled against. At run time the application's SDK is used; older 2.x releases
         without messageSystemAttributeNames are handled (TrailbeamSqsExecutionInterceptor). -->
    <aws.sdk.version>2.59.7</aws.sdk.version>
    <otel.version>1.56.0</otel.version>
    <junit.version>5.11.4</junit.version>
    <!-- For the Lambda wrapper only. The function brings its own; SQSBatchResponse needs events 3.10.0 or later. -->
    <lambda.core.version>1.2.3</lambda.core.version>
    <lambda.events.version>3.14.0</lambda.events.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${otel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The application brings its own SDK. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>${aws.sdk.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- The Lambda wrapper's types (TrailbeamSqsLambdaWrapper, TrailbeamSqsHandler). Only those two classes use
         them, so the interceptor works without them on the classpath. -->
    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-core</artifactId>
      <version>${lambda.core.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-events</artifactId>
      <version>${lambda.events.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Relocated into the jar by the shade plugin below. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
      <exclusions>
        <!-- JDK HTTP sender only: 1.35 MB instead of 4.5 MB, and no OkHttp/Kotlin in the jar. -->
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-sender-okhttp</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-sender-jdk</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The SnapStart hook is registered through org.crac when it is on the classpath (SnapStart.java). -->
    <dependency>
      <groupId>io.github.crac</groupId>
      <artifactId>org-crac</artifactId>
      <version>0.1.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <environmentVariables>
            <TRAILBEAM_OTLP_TRACES_ENDPOINT>http://127.0.0.1:9/v1/traces</TRAILBEAM_OTLP_TRACES_ENDPOINT>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>io.opentelemetry</pattern>
                  <shadedPattern>app.trailbeam.sqs.shaded.otel</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                    <!-- GraalVM metadata that names the unrelocated io.opentelemetry classes. -->
                    <exclude>META-INF/native-image/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Relocates the exporter's HttpSenderProvider service file along with the classes. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Maven Central requires a sources jar and a javadoc jar next to the main jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <doclint>none</doclint>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Publishing to Maven Central: mvn -Prelease deploy. Not run by CI or by agents; the steps are in
      RELEASING.md. It needs a GPG key in the local keyring and a Central Portal token in settings.xml under the
      server ID "central", and the group ID above must be a namespace verified on the Central Portal. Set a
      release version first (no -SNAPSHOT): the Portal's release upload doesn't take snapshot versions.
      autoPublish is off: the upload is validated and then waits on the Portal until someone presses Publish,
      so a mistake can still be dropped.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
