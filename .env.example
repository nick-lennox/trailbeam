# Settings for docker-compose.yaml (the team install). Copy to .env, fill in, and keep .env out of git
# (.gitignore already ignores it). Docker Compose reads .env from this directory.

# The shared access token: ingest, the API and the web screen all need it (README: Access token).
# At least 16 printable ASCII characters, no spaces. Make one with: openssl rand -hex 32
# Services send it as OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>; people type it once
# on the sign-in page. Changing it signs everyone out.
TRAILBEAM_TOKEN=

# The receipt-hash key. The server doesn't read it: every service that uses the Trailbeam packages
# on the same queues needs this same value as TRAILBEAM_RECEIPT_HASH_KEY, so it is kept here with the
# token. Without it the packages use the published default key and the screen warns about it.
# Make one with: openssl rand -hex 32
TRAILBEAM_RECEIPT_HASH_KEY=

# Password of the trailbeam role in the bundled Postgres. Only the Trailbeam container connects to it
# (Postgres's port is not published). It is set when the Postgres volume is first created; changing
# it here later doesn't change it in the database. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Where the server listens on this machine. 0.0.0.0: every interface, so other machines can send to
# it; 127.0.0.1: this machine only. Plain HTTP: put a TLS proxy in front if it crosses a network you
# don't trust.
TRAILBEAM_BIND=0.0.0.0
TRAILBEAM_PORT=4318

# How long spans are kept: a duration (7d, 30d, 12h) or "forever" (README: Retention).
TRAILBEAM_RETENTION=7d

# Queues whose message bodies are stored (comma-separated, * for all). Empty: none (README: Message bodies).
TRAILBEAM_STORE_BODIES=
