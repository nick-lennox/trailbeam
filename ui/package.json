{
  "name": "@trailbeam/ui",
  "version": "0.1.0-dev.22",
  "description": "Trailbeam's views (a message's timeline, and more to come), shared by self-hosted Trailbeam and the hosted app.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design": {
      "types": "./dist/design/index.d.ts",
      "default": "./dist/design/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./fixtures/*": "./dist/fixtures/*",
    "./design.css": "./src/design/design.css",
    "./tokens.css": "./src/design/tokens.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.lib.json && node scripts/copy-fixtures.mjs",
    "prepack": "npm run build:lib",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "react": "^19",
    "lucide-react": ">=0.400"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.2.8",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "lucide-react": "^0.544.0",
    "postcss": "^8.5.33",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
