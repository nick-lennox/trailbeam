  "purge": {
    "description": "Test vectors for contract/span-contract.md section 18 (revision 3.3): the trailbeam purge span. Each case is one PurgeQueue call on 'queue_url'. 'response' is what the call returned: {\"ok\": true} for success, {\"error_code\": c} for an SQS error response with code c, or {\"thrown\": n} for an error named n raised before any response. Each package must emit exactly one span named 'span_name' whose attributes include exactly 'attributes', carry every name in 'present' (values depend on the process) and none in 'absent'. trailbeam.order.issued must be lower than trailbeam.order.returned.",
    "span_name": "trailbeam purge",
    "present": [
      "messaging.client.id",
      "process.pid",
      "trailbeam.order.scope",
      "trailbeam.order.issued",
      "trailbeam.order.returned"
    ],
    "cases": [
      {
        "name": "success",
        "queue_url": "http://localhost:9324/000000000000/orders",
        "response": {
          "ok": true
        },
        "attributes": {
