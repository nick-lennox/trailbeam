<?xml version="1.0" encoding="UTF-8"?>
<!-- The conformance driver for the Java package. Build the package first (`mvn -f java/pom.xml install`),
     then this (`mvn -f conformance/drivers/java/pom.xml package`); run.sh starts it. aws.sdk.version picks the
     SDK the driver runs on, for the version matrix. The package phase also repackages the driver as a Spring Boot
     executable jar (target/*-boot.jar, the SDK and Trailbeam as nested jars under BOOT-INF/lib), for the
     spring-boot variants. The JDK picks the Spring Boot line, so each CI job covers one of its two launchers:
     2.7 on JDK 11 (the classic loader), 3.5 on JDK 17, 4.x on JDK 21 and later (the loader rewritten in 3.2).
     -Dspring.boot.version overrides it. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.trailbeam.kit</groupId>
  <artifactId>conformance-driver-java</artifactId>
  <version>0</version>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <aws.sdk.version>2.59.7</aws.sdk.version>
    <trailbeam.version>0.1.0-SNAPSHOT</trailbeam.version>
    <spring.boot.version>2.7.18</spring.boot.version>
  </properties>

  <profiles>
    <profile>
      <id>boot-3</id>
      <activation><jdk>[17,21)</jdk></activation>
      <properties><spring.boot.version>3.5.16</spring.boot.version></properties>
    </profile>
    <profile>
      <id>boot-4</id>
      <activation><jdk>[21,)</jdk></activation>
      <properties><spring.boot.version>4.2.0</spring.boot.version></properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>
    <!-- Added the way users add it: one dependency, no code. -->
    <dependency>
      <groupId>dev.trailbeam</groupId>
      <artifactId>trailbeam-aws-sdk-v2</artifactId>
      <version>${trailbeam.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>1.7.36</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/classpath.txt</outputFile>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <classifier>boot</classifier>
              <mainClass>trailbeam.kit.Driver</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
