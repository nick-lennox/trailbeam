<Project Sdk="Microsoft.NET.Sdk">

  <!-- The conformance kit's .NET driver: dotnet build -c Release conformance/drivers/dotnet, then run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TrailbeamKitDriver</AssemblyName>
    <!-- The SDK the scenario runs on; the version matrix sets it. -->
    <AwsSdkSqsVersion Condition="'$(AwsSdkSqsVersion)' == ''">4.1.0.2</AwsSdkSqsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="$(AwsSdkSqsVersion)" />
    <!-- The application's own tracing (KIT_APP_TRACING=otel): the stock AWS SDK instrumentation QV-301 measured. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AWS" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../dotnet/src/Trailbeam.Sqs/Trailbeam.Sqs.csproj" />
  </ItemGroup>

</Project>
